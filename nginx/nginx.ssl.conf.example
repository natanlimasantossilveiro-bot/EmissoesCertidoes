# Config depois que o certbot já emitiu o certificado (ver
# docs/DEPLOY_VPS.md). Copie por cima de nginx.conf e reinicie o serviço
# nginx (`docker compose restart nginx`) — troque <DOMINIO> pelo domínio
# de verdade (ex: seu-ip.sslip.io, ou o domínio próprio se comprarem um).
server {
    listen 80;
    server_name <DOMINIO>;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Todo o resto do tráfego HTTP redireciona pra HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name <DOMINIO>;

    ssl_certificate /etc/letsencrypt/live/<DOMINIO>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<DOMINIO>/privkey.pem;

    # ⚠️ Sem isso, o nginx resolve "gateway" pro IP do container só UMA
    # VEZ, na hora que ele próprio sobe, e guarda esse IP pra sempre —
    # cada vez que o container do gateway é recriado (ex: `docker compose
    # up -d` depois de um `git pull`), ele ganha um IP novo, e o nginx
    # continua tentando falar com o IP antigo (conexão recusada, aparece
    # pro usuário como "token inesperado '<'" — o nginx devolvendo a
    # própria página de erro em HTML em vez do JSON do gateway). O
    # `resolver` do Docker (`127.0.0.11`, DNS interno dele) + `set` abaixo
    # faz o nginx reconsultar esse endereço a cada 10s, em vez de fixar
    # pra sempre — não precisa mais reiniciar o nginx depois de recriar o
    # gateway (mesma correção já existente em nginx.conf).
    resolver 127.0.0.11 valid=10s;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    location ~ ^/(auth|admin|portais|dlq|pedidos|lotes)(/|$) {
        set $upstream_gateway http://gateway:8000;
        proxy_pass $upstream_gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
